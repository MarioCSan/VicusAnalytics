# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=vicus
RABBITMQ_PASS=vicus_secret

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=vicus
POSTGRES_PASSWORD=vicus_secret
POSTGRES_DB=vicus_analytics

# ── AlphaSIGCore (arbitrage bot) ──────────────────────────────────────────────
# RabbitMQ connection is auto-built from the vars above — no need to change.
# Copy your .env values from AlphaSIGCore/.env here:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=
POLY_SIGNATURE_TYPE=3
POLY_DEPOSIT_WALLET=
EXECUTION_MODE=notify_only
MARGIN_THRESHOLD=0.04
POLL_INTERVAL=60
WEATHER_MIN_EDGE=0.03
WEATHER_BANKROLL=500
WEATHER_MAX_POSITION_USD=5
WEATHER_POLL_INTERVAL=300
WEATHER_SCAN_LIMIT=200

# ── Vicus API ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5200
